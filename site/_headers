# En-têtes des actifs statiques (Cloudflare Workers). Le fichier n'est pas servi lui-même.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Toujours revalidés : le service worker et les pages qui ne doivent jamais être servies périmées
/sw.js
  Cache-Control: no-cache
/espace.html
  Cache-Control: no-cache
/villa-facts.js
  Cache-Control: no-cache

/ops.html
  X-Robots-Tag: noindex, nofollow
