// Stafflo sur Cloudflare Workers (actifs statiques seulement, aucun script serveur).
// Build : bash scripts/build-site.sh → dist/ (liste blanche des fichiers publics).
// html_handling "none" : /app.html est servi tel quel (pas de redirection vers /app) — le
//   service worker, les clics d'alertes et les retours OAuth/Supabase utilisent les URL en .html.
// not_found_handling "single-page-application" : « / » sert index.html.
{
  "name": "stafflo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
